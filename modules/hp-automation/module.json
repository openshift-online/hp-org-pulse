      { "id": "pipeline", "label": "Bug Pipeline", "icon": "TrendingUp", "default": true },
      { "id": "solve", "label": "Solve", "icon": "Bot" },
      { "id": "refine", "label": "Refine", "icon": "ClipboardList" },
      { "id": "backport", "label": "Backport", "icon": "GitMerge" },
      { "id": "risk", "label": "PR Risk Assessment", "icon": "ChartColumnStacked" },
      { "id": "cve", "label": "CVE Triage", "icon": "Shield" },
      { "id": "go-mod-automerge", "label": "Go Mod Automerge", "icon": "Box", "disabled": true }
    ]
  },
  "server": {
    "entry": "./server/index.js"
  },
  "secrets": {
    "platform": ["jira", "github"]
