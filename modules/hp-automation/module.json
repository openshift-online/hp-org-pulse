      },
      { "path": "backport-tracker/data.json", "notes": "Cached OCPBUGS issues labeled chai-backport with merge outcomes" },
      {
        "path": "risk-assessment/data.json",
        "notes": "Per-repository counts of pull requests carrying each chai-risk-assessment label"
      },
      { "path": "cve-triage/data.json", "notes": "Cached Jira CVE triage metrics per solution" }
    ]
  }
